# Hex-encoded Ethereum private key (must start with 0x)
PRIVATE_KEY=0x...

# RPC endpoint for Sepolia testnet (required for integration tests)
# Get a free key at https://infura.io, https://alchemy.com or https://quicknode.com
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optional: RPC endpoint for Ethereum Mainnet (used by the analyzer CLI)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Binance Testnet API credentials (Week 3 exchange module)
# Generate at https://testnet.binance.vision/ by logging in with GitHub
BINANCE_TESTNET_API_KEY=your_key_here
BINANCE_TESTNET_SECRET=your_secret_here

# Binance Production API credentials (Week 5+ production mode)
# Generate at https://www.binance.com/en/my/settings/api-management
# MUST: disable Withdrawals, disable Futures, set IP whitelist
BINANCE_API_KEY=your_production_key_here
BINANCE_API_SECRET=your_production_secret_here

# Bybit Testnet API credentials (Week 4 multi-exchange module)
# Generate at https://testnet.bybit.com/ → API Management
BYBIT_API_KEY=your_key_here
BYBIT_SECRET=your_secret_here

# Live DEX / arb_bot runtime
# Mainnet or local fork HTTP RPC endpoint used by UniswapV2Swapper / FlashbotsSwapper
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optional WebSocket RPC endpoint used by live pricing / mempool demos
WS_RPC_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Wallet used for on-chain balance sync and live DEX execution
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Private key for the live DEX wallet.
# The env-var name can be changed with --wallet-key-env.
WALLET_PRIVATE_KEY=0x...

# Flashbots relay auth signing key.
# The env-var name can be changed with --flashbots-auth-key-env.
FLASHBOTS_AUTH_PRIVATE_KEY=0x...

# Optional Telegram alerting for arb_bot.
# Use with --alert-webhook-url "$TELEGRAM_WEBHOOK" --alert-provider telegram --alert-telegram-chat-id "$TELEGRAM_CHAT_ID"
TELEGRAM_WEBHOOK=https://api.telegram.org/bot<BOT_TOKEN>/sendMessage
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Arb Bot Runtime Configuration ---

# Mode: true to enable Binance production mode
PRODUCTION=false

# Leg size (base asset units, e.g. 1.0 ETH)
ARB_SIZE=1.0

# Opportunity thresholds
MIN_SCORE=60
MIN_PROFIT_USD=0.001
MIN_SPREAD_BPS=0

# Loop timing (ms)
TICK_MS=1000

# Backend: true for simulation, false for live execution
SIMULATION=true

# Execution limits
MAX_CONCURRENT=1

# Fee model overrides (basis points)
FEE_CEX_TAKER_BPS=10
FEE_DEX_SWAP_BPS=30
FEE_GAS_USD=0

# Risk management
INITIAL_CAPITAL_USD=20000
MAX_TRADE_USD=5000
MAX_DAILY_LOSS_USD=10       # RiskManager daily loss limit
MAX_TRADES_PER_HOUR=20
CONSECUTIVE_LOSS_LIMIT=3

# Breaker settings
MAX_DAILY_LOSS=100         # PnLBreaker (hard halt) cumulative loss limit

# Logging and Safety
VERBOSE=false              # Set to true to see every market probe (noisy)
TRADE_LOG_PATH=trades.jsonl
LOG_DIR=logs
HALT_FILE=/tmp/arb_bot_kill
DEX_ADDRESS_BOOK=configs/address_book_arbitrum.json

# Simulation / Demo seeding
# Format: venue:ASSET=AMOUNT[,ASSET=AMOUNT]... (space or comma separated)
SEED_INVENTORY="binance:USDC=10000,ETH=5 wallet:USDC=10000,ETH=5"